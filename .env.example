# Local Bus Tracking System settings. Keep .env private and never commit it.
APP_ENV=development
BUS_DB_HOST=localhost
BUS_DB_PORT=3306
BUS_DB_USER=bus_tracker_app
BUS_DB_PASSWORD=
BUS_DB_NAME=bus_tracker
# Set only when running behind a proxy you control, for example 1 trusted hop.
TRUSTED_PROXY_HOPS=0
